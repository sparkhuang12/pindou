# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=pindou
POSTGRES_USER=pindou
# Use a URL-safe value because it is interpolated into PINDOU_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

PINDOU_PORT=8000
PINDOU_SESSION_SECRET=replace-with-at-least-32-random-characters
PINDOU_COOKIE_SECURE=0
PINDOU_TRUST_PROXY=0
PINDOU_WORKER_POLL_SECONDS=0.75
PINDOU_WORKER_STALE_SECONDS=900
PINDOU_MAX_PROJECTS_PER_USER=100
PINDOU_MAX_STORAGE_BYTES_PER_USER=2147483648
PINDOU_MAX_JOBS_PER_DAY=100
PINDOU_MAX_CONCURRENT_JOBS_PER_USER=2
PINDOU_MAX_JOB_ATTEMPTS=3

# The account is created on first startup, or promoted if it already exists.
PINDOU_ADMIN_EMAIL=admin@example.com
PINDOU_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PINDOU_ADMIN_NAME=系统管理员

# Optional remote image-model gateway.
PINDOU_MODEL_API_URL=
PINDOU_MODEL_API_KEY=
PINDOU_MODEL_NAME=pixel-art-editor
# Optional comma-separated HTTPS hosts for model image URLs.
PINDOU_MODEL_API_ALLOWED_HOSTS=
